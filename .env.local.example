# Browser-safe (used for auth session)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
# Read-only Postgres role connection string (created in Task 8) — used later by chat
SUPABASE_READONLY_CONNECTION_STRING=

# Server-only (used later by chat + sync)
ANTHROPIC_API_KEY=
# N8N Gestek sync webhook (Sync button on Overview)
N8N_SYNC_WEBHOOK_URL=
N8N_SYNC_TOKEN=

# Sync button safety gate — leave empty/false until the N8N worker is fixed (mass-dup risk). Set true to enable.
SYNC_ENABLED=

# Gestek API (native sync)
GESTEK_API_TOKEN=
GESTEK_SYNC_MONTHS=3

# Vercel Cron auth (Vercel sends this as a Bearer token; also used by /api/cron/confirmations)
CRON_SECRET=

# --- Appointment confirmations (day-before WhatsApp) -----------------------
# Leave CONFIRMATIONS_ENABLED unset/false until the WhatsApp Cloud API + template
# are live — the cron still runs but the route responds 503 without sending anything.
CONFIRMATIONS_ENABLED=
# Base URL of the Lead Qualifier Bot deployment (no trailing slash), e.g. https://bot.example.com
BOT_BASE_URL=
# Shared secret used as a Bearer token BOTH ways: this app -> bot POST /api/confirmations/run,
# and the bot -> this app POST /api/agenda/cancel. Generate one value and set it in both apps' envs.
CONFIRMATIONS_SHARED_SECRET=

# --- Meta Instant Form leads (Ottokit -> /api/leads/form) -------------------
# Bearer token Ottokit sends to POST /api/leads/form. Generate with `openssl rand -hex 32`
# and set the SAME value as an `Authorization: Bearer <secret>` header on the workflow's
# Webhooks -> Custom Request step. See docs/ottokit-form-leads.md.
FORM_LEADS_SECRET=
# Slack Incoming Webhook posted to when a new form lead arrives. Normally LEFT UNSET: the
# Ottokit workflow already has its own Slack + Gmail steps, and setting this would post
# every lead to Slack twice. Leads are recorded and shown on /marketing either way.
SLACK_WEBHOOK_URL=
